def cmd_sub_cycle(args):
    need_root("changing update cycle")

    # Read current timer interval
    current = "6h"
    if has_systemd():
        try:
            result = subprocess.run(
                ["systemctl", "show", "mihomo-update.timer", "--property=OnUnitActiveSec"],
                capture_output=True, text=True, stderr=subprocess.DEVNULL,
            )
            if result.returncode == 0:
                val = result.stdout.split("=", 1)[1].strip()
                if val:
                    current = val
        except Exception:
            pass

    options = ["1h", "2h", "4h", "6h", "12h", "24h", "custom"]

    # Read current value from timer file
    current = "6h"
    timer_path = "/etc/systemd/system/mihomo-update.timer"
    try:
        content = Path(timer_path).read_text()
        import re
        m = re.search(r"OnUnitActiveSec=(.+)", content)
        if m:
            current = m.group(1).strip()
    except Exception:
        pass
    items = []
    for opt in options:
        prefix = "* " if opt == current else "  "
        items.append(f"{prefix}{opt}")

    result = fzf_select(items, "update cycle> ")
    if not result:
        raise SystemExit(EXIT_OK)

    choice = result.lstrip("* ").strip()

    if choice == "custom":
        if sys.stdin.isatty():
            choice = input("Enter interval (e.g., 30m, 2h, 1d): ").strip()
            if not choice:
                print("  aborted")
                raise SystemExit(EXIT_OK)
        else:
            die("custom interval requires interactive terminal", EXIT_INVALID_INPUT)

    # Parse interval to systemd format
    # Supported: Xm, Xh, Xd
    if not choice.endswith(("m", "h", "d")):
        die("interval must end with m (minutes), h (hours), or d (days)", EXIT_INVALID_INPUT)

    # Update timer unit
    timer_path = "/etc/systemd/system/mihomo-update.timer"
    try:
        with open(timer_path, "r") as f:
            content = f.read()

        import re
        new_content = re.sub(
            r"OnUnitActiveSec=.*",
            f"OnUnitActiveSec={choice}",
            content
        )

        with open(timer_path, "w") as f:
            f.write(new_content)

        # Reload systemd and restart timer (skip if no systemd)
        if has_systemd():
            subprocess.run(["systemctl", "daemon-reload"],
                           stderr=subprocess.DEVNULL, check=True)
            if subprocess.run(["systemctl", "is-active", "--quiet", "mihomo-update.timer"],
                              stderr=subprocess.DEVNULL).returncode == 0:
                subprocess.run(["systemctl", "restart", "mihomo-update.timer"],
                               stderr=subprocess.DEVNULL, check=True)

        print(f"  update cycle set to: {choice}")
    except Exception as e:
        die(f"failed to update timer: {e}", EXIT_GENERAL)


