def cmd_dns_set(args):
    need_root("configuring DNS settings")

    state = read_state()
    dns_overrides = state.get("dns", {})

    def load_base_dns():
        base = load_yaml(BASE_CFG) if BASE_CFG.exists() else {}
        return base.get("dns", {})

    base_dns = load_base_dns()

    def show_dns():
        current_mode = dns_overrides.get("enhanced-mode", base_dns.get("enhanced-mode", "redir-host"))
        current_ns = dns_overrides.get("nameservers", base_dns.get("nameserver", []))
        current_fb = dns_overrides.get("fallback", base_dns.get("fallback", []))

        def fmt(val):
            if isinstance(val, list):
                if not val:
                    return "[]"
                return str(val)
            return str(val) if val is not None else "?"

        print("\033[1m── DNS Settings (base.yaml) ──\033[0m")
        print(f"  enhanced-mode:           {base_dns.get('enhanced-mode', '?')}")
        print(f"  ipv6:                    {fmt(base_dns.get('ipv6'))}")
        print(f"  fake-ip-range:           {fmt(base_dns.get('fake-ip-range'))}")
        print(f"  fake-ip-filter:          {fmt(base_dns.get('fake-ip-filter'))}")
        print(f"  default-nameserver:      {fmt(base_dns.get('default-nameserver'))}")
        print(f"  proxy-server-nameserver: {fmt(base_dns.get('proxy-server-nameserver'))}")
        print(f"  direct-nameserver:       {fmt(base_dns.get('direct-nameserver'))}")
        print()
        print("\033[1m── Effective (with overrides) ──\033[0m")
        print(f"  enhanced-mode:  {current_mode}")
        print("  nameservers:")
        if current_ns:
            for i, ns in enumerate(current_ns, 1):
                print(f"    {i}) {ns}")
        else:
            print("    (empty)")
        print("  fallback:")
        if current_fb:
            for i, fb in enumerate(current_fb, 1):
                print(f"    {i}) {fb}")
        else:
            print("    (empty)")
        print()
        print("\033[1m── Configure ─────────────\033[0m")
        print("  1) Enhanced mode")
        print("  2) Nameservers")
        print("  3) Fallback servers")
        print("  4) Reset to base.yaml")
        print("  5) Apply & save")
        print("  6) Cancel")

    def edit_list(label, items):
        while True:
            print(f"\n\033[1m── {label} ──\033[0m")
            if items:
                for i, item in enumerate(items, 1):
                    print(f"    {i}) {item}")
            else:
                print("    (empty)")
            print()
            print("    a) Add")
            print("    r) Remove by number")
            print("    e) Edit by number")
            print("    b) Back")

            choice = input(f"\n  {label} [a/r/e/b]: ").strip().lower()

            if choice == "a":
                url = input("  Enter URL: ").strip()
                if not url:
                    print("  \033[31mempty URL\033[0m")
                    continue
                if not url.startswith(("http://", "https://", "tls://")):
                    print("  \033[31mURL must start with http://, https://, or tls://\033[0m")
                    continue
                items.append(url)
                print(f"  \033[32madded: {url}\033[0m")

            elif choice == "r":
                if not items:
                    print("  \033[33mlist is empty\033[0m")
                    continue
                try:
                    num = int(input("  Remove number: ")) - 1
                    if 0 <= num < len(items):
                        removed = items.pop(num)
                        print(f"  \033[32mremoved: {removed}\033[0m")
                    else:
                        print("  \033[31minvalid number\033[0m")
                except (ValueError, EOFError):
                    print("  \033[31minvalid input\033[0m")

            elif choice == "e":
                if not items:
                    print("  \033[33mlist is empty\033[0m")
                    continue
                try:
                    num = int(input("  Edit number: ")) - 1
                    if 0 <= num < len(items):
                        old = items[num]
                        new_url = input(f"  New URL [{old}]: ").strip()
                        if new_url:
                            if not new_url.startswith(("http://", "https://", "tls://")):
                                print("  \033[31mURL must start with http://, https://, or tls://\033[0m")
                                continue
                            items[num] = new_url
                            print(f"  \033[32mchanged: {old} -> {new_url}\033[0m")
                        else:
                            print("  unchanged")
                    else:
                        print("  \033[31minvalid number\033[0m")
                except (ValueError, EOFError):
                    print("  \033[31minvalid input\033[0m")

            elif choice == "b":
                return items

            else:
                print("  \033[31minvalid choice\033[0m")

    while True:
        show_dns()

        try:
            choice = input("\n  Select [1-6]: ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\n  cancelled")
            return

        if choice == "1":
            items = [
                "redir-host (default, recommended)",
                "fake-ip (faster, some apps may not work)"
            ]
            result = fzf_select(items, "enhanced-mode> ")
            if result:
                if "redir-host" in result:
                    dns_overrides["enhanced-mode"] = "redir-host"
                else:
                    dns_overrides["enhanced-mode"] = "fake-ip"
                print(f"  \033[32menhanced-mode: {dns_overrides['enhanced-mode']}\033[0m")

        elif choice == "2":
            current_ns = dns_overrides.get("nameservers", base_dns.get("nameserver", []))
            ns = list(current_ns)
            edit_list("Nameservers", ns)
            dns_overrides["nameservers"] = ns

        elif choice == "3":
            current_fb = dns_overrides.get("fallback", base_dns.get("fallback", []))
            fb = list(current_fb)
            edit_list("Fallback servers", fb)
            dns_overrides["fallback"] = fb

        elif choice == "4":
            state.pop("dns", None)
            dns_overrides = {}
            base_dns = load_base_dns()
            print("  \033[32mDNS reset to base.yaml defaults\033[0m")

        elif choice == "5":
            if dns_overrides:
                state["dns"] = dns_overrides
            else:
                state.pop("dns", None)
            write_state(state)
            print("\n  \033[32mDNS settings saved.\033[0m Run: sudo mihomoctl restart")
            return

        elif choice == "6":
            print("  cancelled")
            return

        else:
            print("  \033[31minvalid choice\033[0m")


def main():
    p = argparse.ArgumentParser(prog="mihomoctl")

    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status").set_defaults(fn=cmd_status)

    n = sub.add_parser("node")
    nsub = n.add_subparsers(dest="node_cmd", required=True)
    nsub.add_parser("group").set_defaults(fn=cmd_node_group)
    nsub.add_parser("pick").set_defaults(fn=cmd_node_pick)

    test_parser = nsub.add_parser("test")
    test_parser.add_argument("--all", action="store_true")
    test_parser.set_defaults(fn=cmd_node_test)

    sub.add_parser("enable").set_defaults(fn=cmd_enable)
    sub.add_parser("disable").set_defaults(fn=cmd_disable)

    m = sub.add_parser("mode")
    m.add_argument("value", nargs="?")
    m.set_defaults(fn=cmd_mode)

    s = sub.add_parser("sub")
    ssub = s.add_subparsers(dest="sub_cmd", required=True)

    ss = ssub.add_parser("set")
    ss.add_argument("url", nargs="?")
    ss.set_defaults(fn=cmd_sub_set)

    su = ssub.add_parser("update")
    su.set_defaults(fn=cmd_sub_update)

    sc = ssub.add_parser("cycle")
    sc.set_defaults(fn=cmd_sub_cycle)

    sub.add_parser("restart").set_defaults(fn=cmd_restart)
    sub.add_parser("logs").set_defaults(fn=cmd_logs)

    d = sub.add_parser("dns")
    dsub = d.add_subparsers(dest="dns_cmd", required=True)
    ds = dsub.add_parser("set")
    ds.set_defaults(fn=cmd_dns_set)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
