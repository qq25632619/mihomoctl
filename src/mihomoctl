def cmd_node_test(args):
    state = read_state()
    group = state.get("group")
    if not group:
        die("no default group set. Run: mihomoctl node group", EXIT_NOT_FOUND)

    proxies = get_proxies()

    if args.all:
        nodes = get_group_nodes(group, proxies)
    else:
        current = proxies[group].get("now")
        if not current:
            die("no node selected in group", EXIT_NOT_FOUND)
        nodes = [current]

    # Test nodes with progress indicator
    results = []
    if args.all:
        print(f"\n  Testing {len(nodes)} nodes in {group}...")
        for i, node in enumerate(nodes, 1):
            sys.stdout.write(f"\r  [{i}/{len(nodes)}] {node}...")
            sys.stdout.flush()
            latency = test_node_latency(group, node)
            results.append((node, latency))
        sys.stdout.write("\r" + " " * 50 + "\r")
        sys.stdout.flush()
    else:
        node = nodes[0]
        sys.stdout.write(f"\r  Testing {node}...")
        sys.stdout.flush()
        latency = test_node_latency(group, node)
        results.append((node, latency))
        sys.stdout.write("\r" + " " * 50 + "\r")
        sys.stdout.flush()

    if not results:
        die("no results", EXIT_GENERAL)

    # Show results in fzf or formatted table
    if args.all and shutil.which("fzf"):
        items = []
        for node, lat in results:
            lat_str = f"{lat}ms" if lat else "timeout"
            marker = "* " if node == proxies[group].get("now") else "  "
            items.append(f"{marker}{node:<30} {lat_str:>10}")
        # Sort: timeouts last, then by latency
        items.sort(key=lambda x: ("timeout" in x, x))

        p = subprocess.run(
            ["fzf", "--prompt", f"{group} results> ", "--no-sort"],
            input="\n".join(items) + "\n",
            text=True,
            stdout=subprocess.PIPE,
        )
    else:
        # Fallback: formatted table
        results.sort(key=lambda x: x[1] if x[1] else float('inf'))
        print(f"\n  {'node':<30} {'latency':>10}")
        print(f"  {'-'*42}")
        for node, lat in results:
            lat_str = f"{lat}ms" if lat else "timeout"
            marker = "* " if node == proxies[group].get("now") else "  "
            print(f"  {marker}{node:<28} {lat_str:>10}")
    print()


def cmd_node_group(args):
    proxies = get_proxies()
    state = read_state()

    groups = candidate_groups(proxies)
    if not groups:
        die("no proxy groups found", EXIT_NOT_FOUND)

    items = []
    for name, obj, nodes in groups:
        prefix = "* " if name == state.get("group") else "  "
        t = str(obj.get("type", "")).lower()
        items.append(f"{prefix}{name}  ({t})")

    result = fzf_select(items, "group> ")
    if not result:
        raise SystemExit(EXIT_OK)

    # Match by index (items may contain spaces in names)
    try:
        idx = items.index(result)
    except ValueError:
        die("invalid selection", EXIT_GENERAL)
    group = groups[idx][0]

    # Pick node within group
    nodes = group_members(proxies[group])
    if not nodes:
        die(f"group has no selectable nodes: {group}", EXIT_NOT_FOUND)

    node_items = []
    current = proxies[group].get("now", "")
    for n in nodes:
        prefix = "* " if n == current else "  "
        node_items.append(f"{prefix}{n}")

    node_result = fzf_select(node_items, f"{group}> ")
    if not node_result:
        raise SystemExit(EXIT_OK)

    node = node_result.lstrip("* ").strip()

    select_node(group, node)

    state["group"] = group
    state["node"] = node
    write_state(state)


