ETC = Path("/etc/mihomo")
VAR = Path("/var/lib/mihomoctl")

SUB_URL = ETC / "sub.url"
BASE_CFG = ETC / "base.yaml"
CFG = ETC / "config.yaml"
STATE = VAR / "state.json"

CONTROLLER = "http://127.0.0.1:9090"
MIXED_PORT = 7890
MIHOMO_BIN = "/usr/local/bin/mihomo"
MIHOMO_PID = VAR / "mihomo.pid"
MIHOMO_LOG = VAR / "mihomo.log"

# Exit codes
EXIT_OK = 0
EXIT_GENERAL = 1
EXIT_NOT_FOUND = 2
EXIT_API_DOWN = 3
EXIT_AUTH_FAILED = 4
EXIT_INVALID_INPUT = 5
EXIT_DEPENDENCY = 6

GROUP_TYPES = {
    "selector", "select",
}

NON_NODE_NAMES = {
    "DIRECT", "REJECT", "REJECT-DROP", "PASS", "COMPATIBLE",
}


def die(msg, code=EXIT_GENERAL):
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def need_root(action):
    if os.geteuid() != 0:
        die(f"{action} needs root. Run: sudo mihomoctl ...", EXIT_DEPENDENCY)


def has_systemd():
    """Return True if systemd is running (not a Docker container)."""
    return Path("/run/systemd/system").exists()


def ensure_systemd(action):
    """Check systemd. Print warning and return False if unavailable."""
    if has_systemd():
        return True
    print(f"note: systemd not available, using direct process management",
          file=sys.stderr)
    return False


# ── Direct process management (fallback when systemd is absent) ────────────

def _pid_is_alive(pid):
    """Return True if process with given pid exists."""
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def _read_pid():
    """Read mihomo PID from file, or None."""
    if not MIHOMO_PID.exists():
        return None
    try:
        return int(MIHOMO_PID.read_text().strip())
    except (ValueError, OSError):
        return None


def mihomo_is_running():
    """Check whether mihomo is running (direct or systemd)."""
    if has_systemd():
        return subprocess.run(
            ["systemctl", "is-active", "--quiet", "mihomo.service"],
            stderr=subprocess.DEVNULL,
        ).returncode == 0
    pid = _read_pid()
    return pid is not None and _pid_is_alive(pid)


def mihomo_start():
    """Start mihomo directly (no systemd)."""
    if mihomo_is_running():
        print("mihomo is already running")
        return

    VAR.mkdir(parents=True, exist_ok=True)
    with open(MIHOMO_LOG, "a") as log:
        proc = subprocess.Popen(
            [MIHOMO_BIN, "-d", str(ETC)],
            stdout=log, stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    MIHOMO_PID.write_text(str(proc.pid) + "\n")

    # Wait briefly for crash
    time.sleep(1.5)
    if not _pid_is_alive(proc.pid):
        MIHOMO_PID.unlink(missing_ok=True)
        tail = ""
        try:
            lines = MIHOMO_LOG.read_text().splitlines()
            tail = "\n".join(lines[-5:])
        except Exception:
            pass
        die(f"mihomo failed to start. Last log lines:\n{tail}", EXIT_API_DOWN)

    print("mihomo started")


def mihomo_stop():
    """Stop mihomo directly (no systemd)."""
    pid = _read_pid()
    if pid is None or not _pid_is_alive(pid):
        MIHOMO_PID.unlink(missing_ok=True)
        print("mihomo is not running")
        return

    os.kill(pid, signal.SIGTERM)
    for _ in range(10):
        time.sleep(0.3)
        if not _pid_is_alive(pid):
            break
    else:
        # Force kill
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
        time.sleep(0.3)
    MIHOMO_PID.unlink(missing_ok=True)
    print("mihomo stopped")


def mihomo_restart():
    """Restart mihomo directly (no systemd)."""
    if mihomo_is_running():
        mihomo_stop()
        time.sleep(0.5)
    mihomo_start()


def mihomo_service(action):
    """Start/stop/restart mihomo: use systemd if available, else direct."""
    if has_systemd():
        if action == "start":
            subprocess.run(["systemctl", "start", "mihomo.service"],
                           stderr=subprocess.DEVNULL, check=True)
        elif action == "stop":
            subprocess.run(["systemctl", "stop", "mihomo.service"],
                           stderr=subprocess.DEVNULL, check=True)
        elif action == "restart":
            subprocess.run(["systemctl", "restart", "mihomo.service"],
                           stderr=subprocess.DEVNULL, check=True)
        return

    # Direct process management
    if action == "start":
        mihomo_start()
    elif action == "stop":
        mihomo_stop()
    elif action == "restart":
        mihomo_restart()


def read_state():
    if not STATE.exists():
        return {"mode": "tun", "group": None, "node": None}
    try:
        return json.loads(STATE.read_text())
    except Exception:
        return {"mode": "tun", "group": None, "node": None}


def write_state(state):
    VAR.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n")


def load_yaml(path):
    if not path.exists():
        die(f"{path} does not exist", EXIT_NOT_FOUND)
    data = yaml.safe_load(path.read_text()) or {}
    if not isinstance(data, dict):
        die(f"{path} is not a YAML object", EXIT_INVALID_INPUT)
    return data


def save_yaml(path, data):
    path.write_text(
        yaml.safe_dump(
            data,
            allow_unicode=True,
            sort_keys=False,
            default_flow_style=False,
        )
    )


# ── Proxy Link Parser ───────────────────────────────────────────────────────
# Converts vmess:// / vless:// / ss:// / trojan:// / hysteria:// links
# into Clash/Mihomo proxy dicts.

def _first(params, key):
    """Safely get first value from parse_qs result."""
    vals = params.get(key, [])
    return vals[0] if vals else None


def parse_vmess_uri(uri):
    """Parse vmess://base64(JSON) → Clash proxy dict."""
    b64 = uri[len("vmess://"):]
    try:
        text = base64.b64decode(b64, validate=True).decode()
    except Exception:
        return None
    try:
        j = json.loads(text)
    except json.JSONDecodeError:
        return None

    server = j.get("add", "")
    if not server:
        return None

    name = j.get("ps", "").strip() or f"vmess-{server}"
    proxy = {
        "name": name,
        "type": "vmess",
        "server": server,
        "port": int(j.get("port", 0)),
        "uuid": j.get("id", ""),
        "alterId": int(j.get("aid", 0)),
        "cipher": j.get("scy", "auto"),
    }

    net = j.get("net", "tcp")
    if net == "ws":
        proxy["network"] = "ws"
        opts = {"path": j.get("path", "/")}
        host = j.get("host", "")
        if host:
            opts["headers"] = {"Host": host}
        proxy["ws-opts"] = opts
    elif net == "h2":
        proxy["network"] = "h2"
        opts = {"path": j.get("path", "/")}
        host = j.get("host", "")
        if host:
            opts["host"] = [host]
        proxy["h2-opts"] = opts
    elif net == "grpc":
        proxy["network"] = "grpc"
        svc = j.get("path", "").lstrip("/")
        proxy["grpc-opts"] = {"grpc-service-name": svc}

    if j.get("tls", "") == "tls":
        proxy["tls"] = True
        proxy["servername"] = j.get("sni") or j.get("host") or server

    return proxy


def parse_vless_uri(uri):
    """Parse vless://uuid@server:port?params#name → Clash proxy dict."""
    rest = uri[len("vless://"):]

    fragment = ""
    if "#" in rest:
        rest, fragment = rest.rsplit("#", 1)
        fragment = unquote(fragment)

    if "@" not in rest:
        return None

    uuid, _, server_part = rest.partition("@")

    if "?" in server_part:
        host_port, _, query = server_part.partition("?")
    else:
        host_port, query = server_part, ""

    server, _, port_str = host_port.partition(":")
    port = int(port_str) if port_str else 443

    params = parse_qs(query) if query else {}

    proxy = {
        "name": fragment or f"vless-{server}",
        "type": "vless",
        "server": server,
        "port": port,
        "uuid": uuid,
    }

    net = _first(params, "type") or "tcp"
    security = _first(params, "security") or "none"

    if net == "ws":
        proxy["network"] = "ws"
        opts = {"path": _first(params, "path") or "/"}
        host = _first(params, "host")
        if host:
            opts["headers"] = {"Host": host}
        proxy["ws-opts"] = opts
    elif net == "grpc":
        proxy["network"] = "grpc"
        proxy["grpc-opts"] = {"grpc-service-name": _first(params, "serviceName") or ""}

    if security == "tls":
        proxy["tls"] = True
        sni = _first(params, "sni")
        if sni:
            proxy["servername"] = sni
    elif security == "reality":
        proxy["tls"] = True
        reality = {}
        pbk = _first(params, "pbk")
        sid = _first(params, "sid")
        if pbk:
            reality["public-key"] = pbk
        if sid:
            reality["short-id"] = sid
        if reality:
            proxy["reality-opts"] = reality
        sni = _first(params, "sni")
        if sni:
            proxy["servername"] = sni

    flow = _first(params, "flow")
    if flow:
        proxy["flow"] = flow

    return proxy


def parse_trojan_uri(uri):
    """Parse trojan://password@server:port?params#name → Clash proxy dict."""
    rest = uri[len("trojan://"):]

    fragment = ""
    if "#" in rest:
        rest, fragment = rest.rsplit("#", 1)
        fragment = unquote(fragment)

    if "@" not in rest:
        return None

    password, _, server_part = rest.partition("@")

    if "?" in server_part:
        host_port, _, query = server_part.partition("?")
    else:
        host_port, query = server_part, ""

    server, _, port_str = host_port.partition(":")
    port = int(port_str) if port_str else 443

    params = parse_qs(query) if query else {}

    proxy = {
        "name": fragment or f"trojan-{server}",
        "type": "trojan",
        "server": server,
        "port": port,
        "password": password,
    }

    sni = _first(params, "sni") or _first(params, "peer")
    if sni:
        proxy["sni"] = sni

    if _first(params, "allowInsecure") == "1":
        proxy["skip-cert-verify"] = True

    net = _first(params, "type") or "tcp"
    if net == "ws":
        proxy["network"] = "ws"
        opts = {"path": _first(params, "path") or "/"}
        host = _first(params, "host")
        if host:
            opts["headers"] = {"Host": host}
        proxy["ws-opts"] = opts

    return proxy


def parse_ss_uri(uri):
    """Parse ss:// URI → Clash proxy dict (SIP002 + legacy)."""
    rest = uri[len("ss://"):]

    fragment = ""
    if "#" in rest:
        rest, fragment = rest.rsplit("#", 1)
        fragment = unquote(fragment)

    def _b64decode(s):
        for pad in ("", "=", "=="):
            try:
                return base64.b64decode(s + pad).decode()
            except Exception:
                pass
        raise ValueError(f"bad base64: {s[:20]}")

    if "@" in rest:
        b64, _, host_port = rest.partition("@")
        try:
            decoded = _b64decode(b64)
        except Exception:
            return None
        method, _, password = decoded.partition(":")
        server, _, port_str = host_port.partition(":")
        port = int(port_str) if port_str else 8388
    else:
        try:
            decoded = _b64decode(rest)
        except Exception:
            return None
        method_pw, _, server_port = decoded.rpartition("@")
        if not server_port:
            return None
        method, _, password = method_pw.partition(":")
        server, _, port_str = server_port.partition(":")
        port = int(port_str) if port_str else 8388

    if not server:
        return None

    return {
        "name": fragment or f"ss-{server}",
        "type": "ss",
        "server": server,
        "port": port,
        "cipher": method,
        "password": password,
    }


def parse_hysteria_uri(uri):
    """Parse hysteria:// or hysteria2:// → Clash proxy dict."""
    is_v2 = uri.startswith("hysteria2://")
    prefix = "hysteria2://" if is_v2 else "hysteria://"
    rest = uri[len(prefix):]

    fragment = ""
    if "#" in rest:
        rest, fragment = rest.rsplit("#", 1)
        fragment = unquote(fragment)

    auth = ""
    if "@" in rest:
        auth, _, server_part = rest.partition("@")
    else:
        server_part = rest

    if "?" in server_part:
        host_port, _, query = server_part.partition("?")
    else:
        host_port, query = server_part, ""

    server, _, port_str = host_port.partition(":")
    port = int(port_str) if port_str else (443 if is_v2 else 1080)

    params = parse_qs(query) if query else {}

    if is_v2:
        proxy = {
            "name": fragment or f"hysteria2-{server}",
            "type": "hysteria2",
            "server": server,
            "port": port,
            "password": auth or _first(params, "auth") or "",
        }
    else:
        proxy = {
            "name": fragment or f"hysteria-{server}",
            "type": "hysteria",
            "server": server,
            "port": port,
            "auth-str": auth or _first(params, "auth") or "",
            "protocol": _first(params, "protocol") or "udp",
        }

    sni = _first(params, "sni") or _first(params, "peer")
    if sni:
        proxy["sni"] = sni

    if _first(params, "insecure") == "1":
        proxy["skip-cert-verify"] = True

    obfs = _first(params, "obfs")
    if obfs:
        proxy["obfs"] = obfs
        pw = _first(params, "obfs-password")
        if pw:
            proxy["obfs-password"] = pw

    return proxy


PROXY_PARSERS = {
    "vmess://":     parse_vmess_uri,
    "vless://":     parse_vless_uri,
    "trojan://":    parse_trojan_uri,
    "ss://":        parse_ss_uri,
    "hysteria2://": parse_hysteria_uri,
    "hysteria://":  parse_hysteria_uri,
}


def proxy_links_to_config(text):
    """Convert proxy-link text (one URI per line) into a Clash YAML config dict.
    Returns the config dict, or None if no proxies were parsed."""
    proxies = []
    seen = set()
    dup_counter = {}

    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue

        for prefix, parser in PROXY_PARSERS.items():
            if line.startswith(prefix):
                proxy = parser(line)
                if proxy:
                    name = proxy["name"]
                    if name in seen:
                        dup_counter[name] = dup_counter.get(name, 1) + 1
                        proxy["name"] = f"{name} {dup_counter[name]}"
                    else:
                        seen.add(name)
                    proxies.append(proxy)
                break
        else:
            if "://" in line:
                print(f"  warning: unsupported scheme: {line[:80]}",
                      file=sys.stderr)

    if not proxies:
        return None

    # Filter metadata entries injected by some providers
    _META_KW = ["剩余流量", "套餐到期", "到期时间", "官网", "过滤掉",
                "公告", "免费节点", "已过期", "请续费", "订阅地址",
                "更新订阅", "线路数", "过期时间"]
    real = [p for p in proxies if not any(kw in p["name"] for kw in _META_KW)]
    if not real:
        real = proxies

    # Auto-group by region prefix (text before first "-")
    region_groups = {}
    for p in real:
        name = p["name"]
        if "-" in name:
            region = name.split("-")[0].strip()
            if region not in region_groups:
                region_groups[region] = []
            region_groups[region].append(name)

    all_names = [p["name"] for p in real]
    groups = []

    # Per-region groups (regions with >= 2 proxies)
    for region in sorted(region_groups):
        names = region_groups[region]
        if len(names) >= 2:
            groups.append({
                "name": region,
                "type": "select",
                "proxies": names + ["DIRECT"],
            })

    # Global groups
    groups += [
        {
            "name": "Proxy",
            "type": "select",
            "proxies": all_names + ["DIRECT"],
        },
        {
            "name": "Auto",
            "type": "url-test",
            "proxies": all_names,
            "url": "http://www.gstatic.com/generate_204",
            "interval": 300,
        },
    ]

    config = {
        "proxies": real,
        "proxy-groups": groups,
        "rules": [
            "MATCH,Proxy",
        ],
    }
    return config


def generate_config():
    need_root("generating config")

    state = read_state()
    mode = state.get("mode") or "tun"

    cfg = load_yaml(BASE_CFG)

    cfg["mixed-port"] = MIXED_PORT
    cfg["allow-lan"] = False
    cfg["mode"] = cfg.get("mode", "rule")
    cfg["log-level"] = cfg.get("log-level", "info")

    cfg["external-controller"] = "127.0.0.1:9090"
    cfg["secret"] = ""

    profile = cfg.get("profile")
    if not isinstance(profile, dict):
        profile = {}
    profile["store-selected"] = True
    profile.setdefault("store-fake-ip", True)
    cfg["profile"] = profile

    tun = cfg.get("tun")
    if not isinstance(tun, dict):
        tun = {}

    tun["enable"] = mode == "tun"
    tun["stack"] = "gvisor"
    tun.setdefault("auto-route", True)
    tun.setdefault("auto-detect-interface", True)
    tun["strict-route"] = False

    if mode == "tun":
        tun["dns-hijack"] = ["any:53"]
    else:
        tun.pop("dns-hijack", None)

    fake_excludes = {
        "198.18.0.0/15",
        "198.18.0.0/16",
        "198.19.0.0/16",
        "198.18.0.0/24",
        "198.18.0.0/30",
    }

    excludes = tun.get("route-exclude-address")
    if isinstance(excludes, list):
        tun["route-exclude-address"] = [
            x for x in excludes
            if str(x).strip() not in fake_excludes
        ]

    cfg["tun"] = tun

    cfg["ipv6"] = False

    # Apply DNS overrides from state (only what's explicitly set)
    dns_overrides = state.get("dns", {})

    dns = cfg.get("dns")
    if not isinstance(dns, dict):
        dns = {}
        dns["enable"] = True

    if "enhanced-mode" in dns_overrides:
        dns["enhanced-mode"] = dns_overrides["enhanced-mode"]

    if "nameservers" in dns_overrides:
        dns["nameserver"] = dns_overrides["nameservers"]

    if "fallback" in dns_overrides:
        dns["fallback"] = dns_overrides["fallback"]

    cfg["dns"] = dns

    ETC.mkdir(parents=True, exist_ok=True)
    save_yaml(CFG, cfg)

    subprocess.run(["/usr/local/bin/mihomo", "-t", "-d", str(ETC)], check=True)
    print(f"generated {CFG} mode={mode}")


def http_json(method, path, body=None, timeout=8):
    url = CONTROLLER + path
    data = None
    headers = {}

    if body is not None:
        data = json.dumps(body, ensure_ascii=False).encode()
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=data, headers=headers, method=method)

    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read()
        if not raw:
            return None
        return json.loads(raw.decode())


def wait_api(timeout=20):
    end = time.time() + timeout
    last = None
    while time.time() < end:
        try:
            return http_json("GET", "/version")
        except Exception as e:
            last = e
            time.sleep(0.5)
    die(f"mihomo API is not responding at {CONTROLLER}: {last}", EXIT_API_DOWN)


def get_proxies():
    wait_api()
    data = http_json("GET", "/proxies")
    proxies = data.get("proxies") if isinstance(data, dict) else None
    if not isinstance(proxies, dict):
        die("bad /proxies response", EXIT_API_DOWN)
    return proxies


def group_members(obj):
    for key in ("all", "proxies"):
        val = obj.get(key)
        if isinstance(val, list):
            return val
    return []


def is_group(obj):
    return isinstance(obj, dict) and len(group_members(obj)) > 0


def is_selector(obj):
    if not is_group(obj):
        return False
    t = str(obj.get("type", "")).lower()
    return t in GROUP_TYPES or "selector" in t or "select" in t


def is_node_name(name, proxies):
    if name in NON_NODE_NAMES:
        return False
    obj = proxies.get(name)
    if not isinstance(obj, dict):
        return True
    if is_group(obj):
        return False
    t = str(obj.get("type", "")).lower()
    if t in {"direct", "reject"}:
        return False
    return True


def candidate_groups(proxies):
    groups = []
    for name, obj in proxies.items():
        if is_selector(obj):
            nodes = [x for x in group_members(obj) if is_node_name(x, proxies)]
            if nodes:
                groups.append((name, obj, nodes))
    return groups


def get_group_nodes(group, proxies):
    obj = proxies.get(group)
    if not is_group(obj):
        die(f"not a proxy group: {group}", EXIT_NOT_FOUND)

    nodes = group_members(obj)
    if not nodes:
        die(f"group has no selectable nodes: {group}", EXIT_NOT_FOUND)
    return nodes


def select_node(group, node):
    path = "/proxies/" + urllib.parse.quote(group, safe="")
    http_json("PUT", path, {"name": node})
    print(f"selected: {group} -> {node}")


def fzf_select(items, prompt):
    if shutil.which("fzf"):
        p = subprocess.run(
            ["fzf", "--prompt", prompt],
            input="\n".join(items) + "\n",
            text=True,
            stdout=subprocess.PIPE,
        )
        result = p.stdout.strip()
        return result if result else None
    else:
        for i, item in enumerate(items, 1):
            print(f"{i:2d}) {item}")
        try:
            idx = int(input("number: "))
            if 1 <= idx <= len(items):
                return items[idx - 1]
        except (ValueError, EOFError):
            pass
        return None


def cmd_node_pick(args):
    proxies = get_proxies()
    state = read_state()

    group = state.get("group")
    if not group:
        die("no default group set. Run: mihomoctl node group", EXIT_NOT_FOUND)

    nodes = get_group_nodes(group, proxies)
    now = proxies[group].get("now", "")

    items = []
    for n in nodes:
        prefix = "* " if n == now else "  "
        items.append(f"{prefix}{n}")

    result = fzf_select(items, f"{group}> ")
    if not result:
        raise SystemExit(EXIT_OK)

    try:
        idx = items.index(result)
    except ValueError:
        die("invalid selection", EXIT_GENERAL)
    node = nodes[idx]

    select_node(group, node)

    state["node"] = node
    write_state(state)


def test_node_latency(group, node):
    """Returns latency in ms or None on timeout."""
    try:
        path = f"/proxies/{urllib.parse.quote(group, safe='')}/delay"
